{% extends 'base.html.twig' %}

{% block title %}{{ article.title }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-9">

            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Articles</a></li>
                    <li class="breadcrumb-item active" aria-current="page">{{ article.title }}</li>
                </ol>
            </nav>

            <header class="mb-3">
                <h1 class="h2 mb-2">{{ article.title }}</h1>

                <div class="d-flex flex-wrap align-items-center gap-2 text-body-secondary small">
                    <svg class="bi" width="1em" height="1em" aria-hidden="true">
                        <use href="{{ bi }}#person-circle"></use>
                    </svg>
                    <span>
                    {% if article.author %}
                        <a href="{{ path('author_by_slug', {'slug': article.author.slug}) }}"
                           title="Les articles de {{ article.author.username }}"
                           class="link-secondary"
                        >
                        {{ article.author.username }}
                    </a>
                    {% else %}
                        Anonyme
                    {% endif %}
                    </span>

                    <span class="vr mx-1"></span>

                    <svg class="bi" width="1em" height="1em" aria-hidden="true">
                        <use href="{{ bi }}#calendar-date"></use>
                    </svg>
                    <time datetime="{{ article.publishedAt|date('Y-m-d') }}">
                        {{ article.publishedAt|date('d/m/Y') }}
                    </time>

                    {% if article.categories is defined and article.categories|length > 0 %}
                        <span class="vr mx-1"></span>
                        <span class="d-inline-flex flex-wrap gap-1">
            {% for cat in article.categories %}
                <a href="{{ path('article_by_category', { slug: cat.slug }) }}"
                   class="badge rounded-pill text-bg-primary text-decoration-none">
                {{ cat.name }}
              </a>
            {% endfor %}
          </span>
                    {% endif %}
                </div>
            </header>

            <figure class="mb-4">
                <div class="ratio ratio-16x9 rounded overflow-hidden">
                    <img
                        src="{{ vich_uploader_asset(article, 'imageFile') ?? asset('image/placeholder-article-cover.svg') }}"
                        alt="{{ article.title }}"
                        class="w-100 h-100 object-fit-cover"
                        loading="lazy" decoding="async">
                </div>
            </figure>

            <article class="mb-4">
                <div class="content lead">
                    {{ article.content }}
                </div>
            </article>

            {% if article.tags is defined and article.tags|length > 0 %}
                <section class="mt-4 pt-3 border-top">
                    <h2 class="h6 text-body-secondary mb-2">Tags</h2>
                    <div>
                        {% for tag in article.tags %}
                            <a href="{{ path('article_by_tag', { slug: tag.slug }) }}"
                               class="badge rounded-pill text-bg-light border me-1 mb-1 text-decoration-none">
                                #{{ tag.name }}
                            </a>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}
        </div>
    </div>

{% endblock %}
