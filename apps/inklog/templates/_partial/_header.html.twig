<header class="border-bottom">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-between py-3">
            <a href="{{ path('app_home') }}"
               class="d-inline-flex align-items-center link-body-emphasis text-decoration-none me-3">
                <svg class="bi bi-logo" role="img" aria-label="Bootstrap">
                    <use href="{{ bi }}#bootstrap-fill"></use>
                </svg>
            </a>

            <ul class="nav mb-2 mb-md-0 justify-content-center">
                <li><a href="{{ path('app_home') }}" class="nav-link px-2">Home</a></li>
            </ul>

            <div class="text-end">
                {% if app.user %}
                    <div class="d-flex align-items-center gap-3">
                        <a href="{{ path('author_index') }}" class="nav-link px-0 link-underline-dark">
                            Connecté en tant que {{ app.user.username }}
                        </a>
                        <form method="post" action="{{ path('app_logout') }}" class="d-inline-block m-0">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                            <button type="submit" class="btn btn-primary">Logout</button>
                        </form>
                    </div>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-outline-primary">Login</a>
                {% endif %}
            </div>
        </div>
    </div>
</header>
