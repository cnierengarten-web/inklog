{% extends 'base.html.twig' %}

{% block title %}Profil de {{ app.user.username }}{% endblock %}

{% block body %}
    <div class="mb-4 pb-2 border-bottom">
        <h1 class="h2 mb-1">Bienvenue <span data-testid="profile-username">{{ app.user.username }}</span></h1>
    </div>

    {% if (is_granted('ROLE_ADMIN')) %}
        <div class="mb-4 pb-2">
            <h2 class="h3 mb-1">Vos derniers articles</h2>
        </div>
        {% include 'article/_list.html.twig' %}
    {% endif %}
{% endblock %}
